BOT_TOKEN=123456:your-bot-token-from-botfather

# You: admin in every chat this bot serves, and the only one notified about
# bot-wide security events (e.g. someone adding this bot to an unauthorized
# chat). Comma-separated numeric Telegram user IDs.
OWNER_IDS=111111111

# Per-chat admins you hardcode in advance: "chat_id:user_id,user_id;
# chat_id:user_id". Optional if you'd rather admins self-activate via
# INVITE_TOKENS below — the two combine, this is just the no-token-needed
# path for chats you already know the ID of.
# Example serving two groups with different admins:
#   CHAT_ADMINS=-1001111111111:222222222; -1002222222222:333333333,444444444
CHAT_ADMINS=

# Self-service onboarding: share one of these tokens privately (Signal, in
# person — not in the group itself) with an admin you trust to run their own
# group. When they add the bot, it waits (does nothing) until someone runs
# /claim <token> — and only accepts it from someone the Telegram API itself
# confirms is an actual admin of that chat, not just anyone who has the
# token. A chat that's neither in CHAT_ADMINS nor claimed within
# CLAIM_TIMEOUT_SECONDS gets left automatically. Generate a token with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# Leave empty to disable self-service (falls back to immediate auto-leave
# for any unlisted chat).
INVITE_TOKENS=
CLAIM_TIMEOUT_SECONDS=600

TRUSTED_BOT_IDS=
PORT=8080
MAX_VIDEO_MB=20
PHOTO_BLUR_RADIUS=35
VIDEO_BLUR_STRENGTH=30
VIOLATION_THRESHOLD=3
VIOLATION_WINDOW_SECONDS=600

# Optional: auto-arm alarm mode from real air-raid status instead of only
# manual /alarm_on. Leave both empty to disable. Get a token at
# https://devs.alerts.in.ua/, and find your oblast's UID in their docs.
ALERTS_API_TOKEN=
ALERTS_OBLAST_UID=
ALERTS_POLL_SECONDS=60
