BOT_TOKEN=123456:your-bot-token-from-botfather
ADMIN_IDS=111111111,222222222
TRUSTED_BOT_IDS=

# Chat IDs this deployment is allowed to operate in. Anyone can add a public
# bot to their own group and watch how it reacts, so lock this down to your
# own group(s) — the bot auto-leaves (and DMs admins) anywhere else. Leave
# empty only for a throwaway test deployment.
ALLOWED_CHAT_IDS=
PORT=8080
MAX_VIDEO_MB=20
PHOTO_BLUR_RADIUS=35
VIDEO_BLUR_STRENGTH=30
VIOLATION_THRESHOLD=3
VIOLATION_WINDOW_SECONDS=600

# Optional: auto-arm alarm mode from real air-raid status instead of only
# manual /alarm_on. Leave both empty to disable. Get a token at
# https://devs.alerts.in.ua/, and find your oblast's UID in their docs.
ALERTS_API_TOKEN=
ALERTS_OBLAST_UID=
ALERTS_POLL_SECONDS=60
