BOT_TOKEN=123456:your-bot-token-from-botfather

# You: admin in every chat this bot serves, and the only one notified about
# bot-wide security events (e.g. someone adding this bot to an unauthorized
# chat). Comma-separated numeric Telegram user IDs.
OWNER_IDS=111111111

# Per-chat admins you hardcode in advance: "chat_id:user_id,user_id;
# chat_id:user_id". Optional — a chat also self-activates automatically the
# moment it's added, as long as the Telegram API confirms whoever added the
# bot is an actual admin/creator of that chat (no token, no owner
# involvement needed). This is only for chats you'd rather pre-register.
# Example serving two groups with different admins:
#   CHAT_ADMINS=-1001111111111:222222222; -1002222222222:333333333,444444444
CHAT_ADMINS=

TRUSTED_BOT_IDS=
PORT=8080
MAX_VIDEO_MB=20
PHOTO_BLUR_RADIUS=35
VIDEO_BLUR_STRENGTH=30
VIOLATION_THRESHOLD=3
VIOLATION_WINDOW_SECONDS=600

# How long after alarm mode turns off (відбій) strike-result keyword/caption
# filtering keeps applying before winding down entirely — so a chat isn't
# permanently barred from ever discussing a past strike. Coordinates are
# always blocked regardless of this window. Default 2 hours.
POST_ALARM_GRACE_SECONDS=7200

# Optional: auto-arm alarm mode from real air-raid status instead of only
# manual /alarm_on. Leave both empty to disable. Get a token at
# https://devs.alerts.in.ua/. ALERTS_OBLAST_UID is comma-separated — some
# oblasts are one UID (м. Київ = 31), densely populated ones are split into
# per-raion UIDs that all share the oblast name, so "the whole oblast" means
# listing every raion's UID (Київська область = 73,74,75,76,77,78,79).
ALERTS_API_TOKEN=
ALERTS_OBLAST_UID=
ALERTS_POLL_SECONDS=60

# Optional: DM owners "you were down from X to Y" using UptimeRobot's own
# logs for this bot's /health monitor — necessarily retrospective, since
# code that isn't running can't report that it isn't running. Use a
# Read-Only API key (My Settings -> API Settings on UptimeRobot), not the
# Main key — this only ever reads logs. UPTIMEROBOT_MONITOR_ID is the
# numeric id in the monitor's dashboard URL. Leave the key empty to disable.
UPTIMEROBOT_API_KEY=
UPTIMEROBOT_MONITOR_ID=
UPTIMEROBOT_POLL_SECONDS=600

# Optional: persist claimed admins, custom /addkeyword terms, and
# alarm/lockdown state across restarts via Upstash Redis's REST API (free
# tier, no TCP client needed — upstash.com, create a database, copy the
# REST URL/token from its dashboard). Leave either empty to run fully
# in-memory as before: the bot still works, it just re-loses this state on
# every restart/redeploy.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
