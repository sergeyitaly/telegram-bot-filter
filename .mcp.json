{
  "mcpServers": {
    "telegram-bot-api": {
      "command": "node",
      "args": [".claude/mcp-servers/telegram-bot-api.mjs"]
    },
    "fetch": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-fetch"]
    },
    "render": {
      "command": "node",
      "args": [".claude/mcp-servers/render-mcp.mjs"]
    },
    "upstash": {
      "command": "node",
      "args": [".claude/mcp-servers/upstash-mcp.mjs"]
    },
    "uptimerobot": {
      "command": "node",
      "args": [".claude/mcp-servers/uptimerobot-mcp.mjs"]
    }
  }
}
